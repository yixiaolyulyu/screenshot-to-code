# Copy this file to `.env.production` (or set these as environment variables in
# your Vercel project) when deploying the frontend.
#
# Replace the URL below with your Render backend URL after the backend is deployed.
# Example: https://screenshot-to-code-backend.onrender.com
#
# IMPORTANT:
#   - Use https / wss in production (Vercel only serves over https, browsers will
#     block insecure ws:// from a https:// page).
#   - The `VITE_` prefix is required for Vite to expose the variable to the frontend.

VITE_HTTP_BACKEND_URL=https://your-render-app.onrender.com
VITE_WS_BACKEND_URL=wss://your-render-app.onrender.com
